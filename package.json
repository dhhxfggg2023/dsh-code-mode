{
  "name": "dsh-code-mode",
  "version": "0.1.13",
  "private": true,
  "description": "编程模式：为大型项目的创造与维护而设的 DSH 自带模式 — 项目账本、开局简报、反重复门禁。",
  "type": "module",
  "main": "./lib/web-routes.js",
  "exports": {
    ".": "./lib/web-routes.js",
    "./lib/*.js": "./lib/*.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "dsh",
    "coding-agent",
    "project-ledger",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "INSTALL.md",
    "OVERVIEW.md"
  ]
}
